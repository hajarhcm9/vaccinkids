# VacciniKids Backend — Environment Variables
PORT=3000
NODE_ENV=development

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vaccinikids
DB_USER=vaccinikids_user
DB_PASSWORD=vaccinikids_password
POSTGRES_USER=vaccinikids_user
POSTGRES_PASSWORD=vaccinikids_password
POSTGRES_DB=vaccinikids

# ---- JWT ----
JWT_SECRET=supersecretjwtkey1234567890
JWT_REFRESH_SECRET=supersecretrefreshkey1234567890
JWT_EXPIRES_IN=1h

# ---- OTP ----
OTP_HASH_SECRET=supersecretotpkey1234567890

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Staff App ----
STAFF_API_BASE_URL=http://192.168.1.6:3000/api

# ---- Parent Mobile App (Expo) ----
# Doit pointer vers l'IP réelle du serveur (pas 10.0.2.2 qui marche seulement sur l'émulateur Android)
EXPO_PUBLIC_API_URL=http://192.168.1.6:3000/api
