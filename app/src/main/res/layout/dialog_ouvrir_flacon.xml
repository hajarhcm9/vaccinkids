<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rose"
    android:padding="24dp">

    <!-- Badge Scénario B (visible uniquement si forcé) -->
    <TextView
        android:id="@+id/tvBadgeScenario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠ Scénario B — Ouverture forcée"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_badge_white_alpha"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Titre dynamique -->
    <TextView
        android:id="@+id/tvTitreFlacon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ouvrir un nouveau flacon"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Avertissement (visible uniquement si forcé) -->
    <TextView
        android:id="@+id/layoutAvertissementFlacon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seuil non atteint — une justification est obligatoire pour continuer."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.5"
        android:background="@drawable/bg_info_box_white_alpha"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Vaccin -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vaccin"
        android:textColor="#E0FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerVaccinFlacon"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_field_rose"
        android:layout_marginBottom="12dp" />

    <!-- Numéro de lot -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Numéro de lot"
        android:textColor="#E0FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etLotFlacon"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="ex: LOT-2025-A"
        android:textColorHint="#99FFFFFF"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_field_rose"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <!-- Justification (visible uniquement si forcé) -->
    <LinearLayout
        android:id="@+id/layoutJustification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Justification obligatoire"
            android:textColor="#FFDDDD"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etJustificationFlacon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expliquez pourquoi l'ouverture est nécessaire..."
            android:textColorHint="#99FFFFFF"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_field_rose"
            android:padding="12dp"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4DFFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAnnulerFlacon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Annuler"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_ghost_rose" />

        <Button
            android:id="@+id/btnOuvrirFlacon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Ouvrir"
            android:textColor="#FF8A80"
            android:background="@drawable/bg_btn_white_round" />

    </LinearLayout>
</LinearLayout>