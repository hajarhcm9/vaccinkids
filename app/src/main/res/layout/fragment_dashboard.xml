<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="110dp">

            <!-- ══════════════════════════════════════
                 HEADER — avatar + greeting + bell
            ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="22dp">

                <!-- Avatar with teal ring -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDashboardAvatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_medical_staff"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/brand_teal"
                    app:strokeWidth="2dp" />

                <!-- Greeting -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bonjour,"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDashboardNurseName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Infirmier Samira"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.01" />
                </LinearLayout>

                <!-- Notification bell -->
                <FrameLayout
                    android:id="@+id/btnDashboardNotifications"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_kpi_card"
                    android:elevation="2dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Notifications"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/text_primary" />
                </FrameLayout>
            </LinearLayout>

            <!-- Centre name sub-label -->
            <TextView
                android:id="@+id/tvDashboardCenterName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="82dp"
                android:layout_marginTop="1dp"
                android:text="Centre de santé Al Amal"
                android:textColor="@color/brand_teal"
                android:textSize="12sp" />

            <!-- ══════════════════════════════════════
                 HERO CARD — today's overview
            ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvTodayBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="22dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/stormy_teal"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_hero_dashboard"
                    android:minHeight="170dp"
                    android:padding="22dp">

                    <!-- Text column -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <!-- Date chip -->
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_white_glow_circle"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp">
                            <TextView
                                android:id="@+id/tvDashboardDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lundi, 16 Juin 2025"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <!-- Big stat -->
                        <TextView
                            android:id="@+id/tvDashboardSessionsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="4"
                            android:textColor="@color/white"
                            android:textSize="52sp"
                            android:textStyle="bold"
                            android:lineHeight="52dp"
                            android:letterSpacing="-0.03" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sessions actives"
                            android:textColor="@color/white_80"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Decorative watermark icon (top-right) -->
                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="end|top"
                        android:alpha="0.12"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar_event"
                        app:tint="@color/white" />

                    <!-- Small sparkle bottom-right -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="end|bottom"
                        android:layout_margin="14dp"
                        android:background="@drawable/bg_amber_circle"
                        android:alpha="0.7" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════
                 KPI ROW — 4 metric cards
            ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/llKpiRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- RDV -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_kpi_icon_blue">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar_event"
                                app:tint="@color/info" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/tvKpiRdv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="--"
                            android:textColor="@color/info"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="RDV"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Vaccinés -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_kpi_icon_green">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_syringe"
                                app:tint="@color/success" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/tvKpiVaccines"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="--"
                            android:textColor="@color/success"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Vaccinés"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- En attente -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_kpi_icon_orange">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_queue_people"
                                app:tint="@color/warning" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/tvKpiWaiting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="--"
                            android:textColor="@color/warning"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Attente"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Absents -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_kpi_icon_red">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_logout"
                                app:tint="@color/error" />
                        </FrameLayout>
                        <TextView
                            android:id="@+id/tvKpiAbsents"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="--"
                            android:textColor="@color/error"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Absents"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ══════════════════════════════════════
                 PROCHAIN RDV — section title + card
            ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNextRdvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Prochain RDV"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voir tout"
                    android:textColor="@color/brand_teal"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- RDV card with left teal accent bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvNextRdv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Left teal accent bar -->
                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="@color/brand_teal" />

                    <!-- Card content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="18dp">

                        <!-- Time chip -->
                        <TextView
                            android:id="@+id/tvNextRdvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_time_chip"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="09:30"
                            android:textColor="@color/brand_teal_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Name + age -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNextRdvPatient"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Youssef Amine"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvNextRdvAge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="2 ans, 3 mois"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Vaccine badge -->
                        <TextView
                            android:id="@+id/tvNextRdvType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_orange_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:text="Rappel DTC"
                            android:textColor="@color/warning_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════
                 QR SCANNER — main CTA
            ═══════════════════════════════════════ -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dashboardOpenScan"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_qr_btn"
                android:drawableStart="@drawable/ic_scan"
                android:drawablePadding="10dp"
                android:text="  Scanner QR"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:stateListAnimator="@null"
                android:elevation="6dp" />

            <TextView
                android:id="@+id/dashboardMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="10dp"
                android:textColor="@color/error_dark"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
