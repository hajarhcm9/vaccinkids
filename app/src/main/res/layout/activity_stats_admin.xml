<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- ═══ HEADER ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_teal"
            android:gravity="center"
            android:layout_marginEnd="14dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_bar_chart"
                android:contentDescription="@null"
                app:tint="@color/brand_teal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statistiques"
                android:textSize="26sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vue consolidée de l'activité"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/statsProgress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ═══ CENTRE SELECTOR CARD ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@color/brand_teal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PÉRIMÈTRE"
                        android:textSize="10sp"
                        android:textColor="@color/brand_teal"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="4dp" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinnerStatsCentre"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@null" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStatsRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Rafraîchir"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/brand_teal"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_dashboard"
                    app:iconTint="@color/white"
                    app:iconSize="14dp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ STATUS MESSAGE ═══ -->
    <TextView
        android:id="@+id/tvStatsMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- ═══ SCROLLABLE STATS CONTENT ═══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
