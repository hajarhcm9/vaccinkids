<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stocksAdminRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="22dp"
                android:paddingBottom="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stocks"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Surveillance des stocks vaccins"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- KPI row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_kpi_icon_blue">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_package"
                                android:contentDescription="@null"
                                app:tint="@color/brand_lavender" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvStockTotal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:text="4 666"
                            android:textColor="@color/brand_lavender"
                            android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total doses"
                            android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="3dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_kpi_icon_orange">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_notifications"
                                android:contentDescription="@null"
                                app:tint="@color/warning" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvStockFaibles"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:text="5"
                            android:textColor="@color/warning"
                            android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stocks faibles"
                            android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                            android:background="@drawable/bg_kpi_icon_red">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_notifications"
                                android:contentDescription="@null"
                                app:tint="@color/error" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvStockPerimes"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:text="0"
                            android:textColor="@color/error"
                            android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Périmés"
                            android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Alert stocks section title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="10dp"
                android:text="Vigilance immédiate"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStocksMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="22dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Alert RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStocksAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="22dp"
                android:nestedScrollingEnabled="false" />

            <!-- OK stocks section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="Stocks suffisants"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStocksOk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="22dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
