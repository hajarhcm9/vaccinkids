<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- ══════ HEADER ══════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rendez-vous"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/tvRdvDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Aujourd'hui"
                android:textColor="@color/brand_teal"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Filter button -->
        <FrameLayout
            android:id="@+id/btnFilterRdv"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_kpi_card"
            android:elevation="2dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Filtrer"
                android:src="@drawable/ic_more_horizontal"
                app:tint="@color/brand_teal" />
        </FrameLayout>
    </LinearLayout>

    <!-- ══════ SEARCH BAR ══════ -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        app:startIconDrawable="@drawable/ic_scan"
        app:startIconTint="@color/brand_teal"
        app:boxStrokeColor="@color/pearl_aqua"
        app:boxStrokeWidthFocused="2dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxBackgroundColor="@color/white"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchRdv"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Rechercher un enfant…"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ══════ FILTER CHIPS ══════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="22dp"
        android:paddingBottom="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTous"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_active"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Tous"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipConfirmes"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Confirmés"
                android:textColor="@color/brand_teal"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipAttente"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="En attente"
                android:textColor="@color/brand_teal"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipAbsents"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Absents"
                android:textColor="@color/brand_teal"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ══════ LIST / EMPTY STATE ══════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRdv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="22dp"
            android:paddingBottom="110dp" />

        <LinearLayout
            android:id="@+id/emptyRdv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_kpi_icon_blue"
                android:elevation="0dp">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:alpha="0.5"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_event"
                    app:tint="@color/brand_teal" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Aucun rendez-vous"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Il n'y a aucun RDV pour ce filtre."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
