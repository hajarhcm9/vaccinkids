<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Badge N°RDV -->
        <TextView
            android:id="@+id/tvBadgeRdv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RDV#12"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#2196F3"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomPatient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Youssef Benali"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvVaccinDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="DTCoq - 15 Jan | Parent: Fatima"
                android:textSize="13sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/tvParent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parent: Fatima"
                android:textSize="12sp"
                android:textColor="#BDBDBD"
                android:visibility="gone" />

        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatut"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIRMÉ"
            app:chipBackgroundColor="#E3F2FD"
            android:textColor="#2196F3" />

    </LinearLayout>

</androidx.cardview.widget.CardView>