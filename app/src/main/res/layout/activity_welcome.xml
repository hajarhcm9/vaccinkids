<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_screen">

    <!-- ══════════════════════════════════════════
         AMBIENT BACKGROUND BLOBS
    ═══════════════════════════════════════════ -->

    <!-- Top-left teal blob -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:alpha="0.55"
        android:background="@drawable/bg_kpi_icon_teal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="-100dp"
        android:layout_marginTop="-100dp" />

    <!-- Bottom-right teal blob -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.40"
        android:background="@drawable/bg_kpi_icon_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="-70dp"
        android:layout_marginBottom="-70dp" />

    <!-- ══════════════════════════════════════════
         LOGO ROW
    ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/llWelcomeLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="56dp">

        <!-- Icon circle -->
        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_welcome_logo">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_medical_staff"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- App name + badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vaccin"
                    android:textColor="@color/brand_teal"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kids"
                    android:textColor="@color/tangerine_dream"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_badge_teal"
                android:letterSpacing="0.15"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="STAFF"
                android:textColor="@color/brand_teal_dark"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════════
         BIENVENUE TITLE
    ═══════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvWelcomeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Bienvenue !"
        android:textColor="#1F2937"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        app:layout_constraintTop_toBottomOf="@id/llWelcomeLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="22dp"
        android:layout_marginHorizontal="24dp" />

    <!-- ══════════════════════════════════════════
         SUBTITLE
    ═══════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvWelcomeSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Prendre soin de chaque enfant,\nprotéger leur avenir."
        android:textColor="#6B7280"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.5"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="48dp" />

    <!-- ══════════════════════════════════════════
         ILLUSTRATION — heart backdrop + nurse image
    ═══════════════════════════════════════════ -->

    <!-- Soft heart-shaped glow behind illustration -->
    <View
        android:id="@+id/vIllustrationHeart"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.70"
        android:background="@drawable/bg_kpi_icon_teal"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Main nurse+child illustration (floating) -->
    <ImageView
        android:id="@+id/ivHeroIllustration"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/welcome_hero_illustration"
        app:layout_constraintTop_toTopOf="@id/vIllustrationHeart"
        app:layout_constraintBottom_toBottomOf="@id/vIllustrationHeart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-15dp" />

    <!-- ══════════════════════════════════════════
         COMMENCER BUTTON
    ═══════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCommencer"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_btn_commencer"
        android:stateListAnimator="@null"
        android:elevation="6dp"
        android:text="Commencer"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        app:backgroundTint="@null"
        app:cornerRadius="30dp"
        app:rippleColor="#33FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/vIllustrationHeart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="20dp" />

    <!-- ══════════════════════════════════════════
         EN SAVOIR PLUS
    ═══════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvEnSavoirPlus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="En savoir plus"
        android:textColor="#4DAAA8"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnCommencer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />

    <!-- ══════════════════════════════════════════
         PAGINATION DOTS
    ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/llPaginationDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvEnSavoirPlus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="28dp">

        <!-- Active dot -->
        <View
            android:layout_width="26dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_circle_teal" />

        <!-- Inactive dots -->
        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_inactive" />
        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_inactive" />
        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_inactive" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
