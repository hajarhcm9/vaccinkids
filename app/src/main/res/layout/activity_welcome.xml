<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Decorative teal blobs -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.07"
        android:background="@drawable/bg_circle_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="60dp"
        android:translationY="-60dp" />

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:alpha="0.05"
        android:background="@drawable/bg_circle_teal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="-40dp"
        android:translationY="120dp" />

    <!-- Logo + Brand -->
    <LinearLayout
        android:id="@+id/llLogoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Icon box -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_welcome_logo">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_syringe"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- VaccinKids wordmark -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vaccin"
                android:textColor="@color/brand_teal"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kids"
                android:textColor="@color/brand_coral"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.3"
            android:text="STAFF"
            android:textColor="@color/brand_teal"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bienvenue + subtitle -->
    <TextView
        android:id="@+id/tvWelcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Bienvenue !"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llLogoContainer" />

    <TextView
        android:id="@+id/tvWelcomeSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="44dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Prenez soin de chaque enfant,\nprotégez leur avenir."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeTitle" />

    <!-- Illustration -->
    <FrameLayout
        android:id="@+id/flIllustration"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintBottom_toTopOf="@id/llDots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeSubtitle">

        <!-- Heart/oval backdrop -->
        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_illustration_oval" />

        <!-- Outer faint ring -->
        <View
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:alpha="0.25"
            android:background="@drawable/bg_circle_teal" />

        <!-- Medical staff icon -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_medical_staff"
            app:tint="@color/brand_teal" />
    </FrameLayout>

    <!-- Pagination dots -->
    <LinearLayout
        android:id="@+id/llDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnCommencer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Active dot (filled + ring) -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_circle_teal" />

        <!-- Inactive dots -->
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot_inactive" />
    </LinearLayout>

    <!-- CTA Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCommencer"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="12dp"
        android:text="Commencer"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        app:backgroundTint="@color/brand_teal"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toTopOf="@id/tvEnSavoirPlus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- En savoir plus -->
    <TextView
        android:id="@+id/tvEnSavoirPlus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="En savoir plus"
        android:textColor="@color/brand_teal"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
