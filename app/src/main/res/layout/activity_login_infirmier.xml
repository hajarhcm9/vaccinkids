<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF5E6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header jaune-rose -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFB347" />

            <View
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-60dp"
                android:layout_marginEnd="-60dp"
                android:background="@drawable/circle_pink_alpha" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingBottom="30dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    app:cardCornerRadius="36dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="💉"
                        android:textSize="32sp"
                        android:gravity="center" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VacciniKids"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESPACE INFIRMIER"
                    android:textColor="#FFF0D0"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Card Login -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-36dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connexion Infirmier"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="#C8550A"
                    android:layout_gravity="center"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Veuillez entrer votre CIN et votre mot de passe."
                    android:textSize="13sp"
                    android:textColor="#B07050"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="24dp" />

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CIN"
                    android:textSize="11sp"
                    android:textColor="#C8550A"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="7dp" />

                <EditText
                    android:id="@+id/etEmailInfirmier"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="ADMIN01"
                    android:inputType="textCapCharacters"
                    android:background="@drawable/input_orange_bg"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:textColor="#7A3010"
                    android:textColorHint="#D0A080"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvEmailErrorInfirmier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E02060"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp" />

                <!-- Mot de passe -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOT DE PASSE"
                    android:textSize="11sp"
                    android:textColor="#C8550A"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="7dp" />

                <EditText
                    android:id="@+id/etPasswordInfirmier"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="••••••••••"
                    android:inputType="textPassword"
                    android:background="@drawable/input_orange_bg"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:textColor="#7A3010"
                    android:textColorHint="#D0A080"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvPasswordErrorInfirmier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E02060"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

                <!-- Bouton -->
                <Button
                    android:id="@+id/btnLoginInfirmier"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="SE CONNECTER"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:letterSpacing="0.08"
                    android:backgroundTint="#FFB347"
                    android:layout_marginTop="6dp"
                    app:cornerRadius="14dp" />

                <!-- Séparateur -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#FFE0B0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Centre Es-Salaam · Oujda"
                        android:textSize="11sp"
                        android:textColor="#D0A070"
                        android:paddingHorizontal="12dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#FFE0B0" />

                </LinearLayout>

                <!-- Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/badge_orange_bg"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_orange_bg"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accès réservé au personnel soignant"
                        android:textSize="12sp"
                        android:textColor="#C8550A"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
