<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/queueRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ══════ HEADER ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="File d'attente"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Temps réel · session du jour"
                    android:textColor="@color/brand_teal"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Live indicator -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_kpi_card"
                android:elevation="2dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/brand_teal" />
            </FrameLayout>
        </LinearLayout>

        <!-- ══════ TAB SWITCHER ══════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="22dp"
            android:background="@drawable/bg_segment_container"
            android:orientation="horizontal"
            android:padding="5dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueWaitingTab"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="En attente"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_teal"
                app:rippleColor="@color/pearl_aqua" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/queueCalledTab"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Appelés"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                app:rippleColor="@color/pearl_aqua" />
        </LinearLayout>

        <!-- ══════ STATE: loading / message ══════ -->
        <ProgressBar
            android:id="@+id/queueProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_teal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/queueMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- ══════ LIST ══════ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="22dp"
            android:paddingBottom="16dp" />

        <!-- ══════ CALL NEXT CTA ══════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/queueCallNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_teal_pill"
            android:text="Appeler le prochain"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="4dp"
            app:backgroundTint="@null"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_queue_people"
            app:iconTint="@color/white"
            app:iconSize="22dp"
            app:iconGravity="textStart" />

    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
