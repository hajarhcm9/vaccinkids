<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/staff_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestion des stocks"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/staff_ink"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/inputCentreStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Centre ID"
        android:inputType="number" />

    <Button
        android:id="@+id/btnChargerStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Charger stock et historique" />

    <Button
        android:id="@+id/btnAjouterEntreeStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enregistrer une entree"
        android:backgroundTint="@color/staff_primary"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewStocks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Historique des mouvements"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewStockMovements"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"/>

</LinearLayout>
