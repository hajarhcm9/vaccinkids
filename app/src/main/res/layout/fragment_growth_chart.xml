<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- ══════ HEADER ══════ -->
    <LinearLayout
        android:id="@+id/rlGrowthHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingTop="22dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/btnBackGrowth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_kpi_card"
            android:elevation="2dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Retour"
                android:rotation="180"
                android:src="@drawable/ic_logout"
                app:tint="@color/brand_teal" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Courbe de croissance"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <!-- ══════ PATIENT CARD ══════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llGrowthPatient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/rlGrowthHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <!-- Avatar circle -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivGrowthAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_medical_staff"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/pearl_aqua"
                app:strokeWidth="2.5dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGrowthPatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGrowthPatientAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Âge inconnu"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Gender badge -->
            <TextView
                android:id="@+id/tvGrowthGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_info"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Garçon"
                android:textColor="@color/info_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════ SEGMENT TABS ══════ -->
    <LinearLayout
        android:id="@+id/llGrowthTabs"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_segment_container"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/llGrowthPatient"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabPoids"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Poids"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_teal"
            app:cornerRadius="20dp"
            app:rippleColor="@color/teal_100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabTaille"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Taille"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:rippleColor="@color/teal_100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabImc"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="IMC"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:rippleColor="@color/teal_100" />
    </LinearLayout>

    <!-- ══════ CHART AREA ══════ -->
    <LinearLayout
        android:id="@+id/llChartContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_kpi_card"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/llGrowthTabs"
        app:layout_constraintBottom_toTopOf="@id/llGrowthFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Current value row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvGrowthAxisLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Poids (kg)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/brand_teal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGrowthEvolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/success"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- MPAndroidChart -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/lineChartGrowth"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Percentile legend -->
        <LinearLayout
            android:id="@+id/llPercentileLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <!-- P3 -->
            <View
                android:layout_width="14dp"
                android:layout_height="8dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_legend_dot_gray" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="P3"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- P15 -->
            <View
                android:layout_width="14dp"
                android:layout_height="8dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_legend_dot_red" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="P15"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- P50 -->
            <View
                android:layout_width="14dp"
                android:layout_height="8dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_legend_dot_green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="P50"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- P85 -->
            <View
                android:layout_width="14dp"
                android:layout_height="8dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_legend_dot_teal" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="P85"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- P97 -->
            <View
                android:layout_width="14dp"
                android:layout_height="8dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_legend_dot_orange" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P97"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ══════ FOOTER ══════ -->
    <LinearLayout
        android:id="@+id/llGrowthFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingBottom="20dp"
        android:paddingTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLastMeasure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dernière mesure"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastMeasureDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="--"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddMeasure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Ajouter une mesure"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/brand_teal"
            app:tint="@color/white"
            app:fabSize="normal"
            app:elevation="6dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
