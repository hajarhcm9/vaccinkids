<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- ══════════════════════════════════════
         HEADER (gradient)
    ═══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/rlGrowthHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_more_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back button -->
        <FrameLayout
            android:id="@+id/btnBackGrowth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_alpha"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Retour"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Courbe de croissance"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Spacer for centering title -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- ══════════════════════════════════════
         PATIENT CARD
    ═══════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llGrowthPatient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rlGrowthHeader"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- Avatar with initials (sex-colored in code) -->
            <FrameLayout
                android:id="@+id/flGrowthAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_staff_primary">
                <TextView
                    android:id="@+id/tvGrowthInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="?"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Name + age -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGrowthPatientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Patient"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGrowthPatientAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Âge inconnu"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Gender badge (NOW visible, set dynamically) -->
            <TextView
                android:id="@+id/tvGrowthGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_info"
                android:paddingHorizontal="11dp"
                android:paddingVertical="5dp"
                android:text="Garçon"
                android:textColor="@color/info_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════
         SEGMENT TABS
    ═══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/llGrowthTabs"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_segment_container"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llGrowthPatient">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabPoids"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚖ Poids"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_teal"
            app:cornerRadius="20dp"
            app:rippleColor="@color/teal_100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabTaille"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📏 Taille"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:backgroundTint="@null"
            app:rippleColor="@color/teal_100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabImc"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📊 IMC"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:backgroundTint="@null"
            app:rippleColor="@color/teal_100" />
    </LinearLayout>

    <!-- ══════════════════════════════════════
         PERCENTILE STATUS BANNER (dynamic)
    ═══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/llPercentileStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge_success"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llGrowthTabs">

        <TextView
            android:id="@+id/tvPercentileIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="✓"
            android:textColor="@color/success_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPercentileText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Croissance normale (P15 – P85)"
            android:textColor="@color/success_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════════════════════════════════════
         CHART CARD
    ═══════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llChartContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:layout_constraintBottom_toTopOf="@id/llGrowthFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llPercentileStatus"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:paddingHorizontal="14dp">

            <!-- ── Current value header row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGrowthAxisLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Poids (kg)"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvGrowthEvolution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Big current value -->
                <TextView
                    android:id="@+id/tvCurrentValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- kg"
                    android:textColor="@color/brand_teal"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline" />

            <!-- ── Chart + overlays ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- The actual chart -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChartGrowth"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Loading spinner overlay -->
                <ProgressBar
                    android:id="@+id/pbGrowthLoading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/brand_teal"
                    android:visibility="visible" />

                <!-- Empty state overlay -->
                <LinearLayout
                    android:id="@+id/llGrowthEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:alpha="0.25"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bar_chart"
                        app:tint="@color/brand_teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="Aucune mesure enregistrée"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Ajoutez la première mesure via le bouton ci-dessous"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Divider above legend -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/outline" />

            <!-- ── Percentile legend ── -->
            <LinearLayout
                android:id="@+id/llPercentileLegend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="2dp">

                <View android:layout_width="16dp" android:layout_height="3dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_legend_dot_gray" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="P3" android:textColor="@color/text_tertiary" android:textSize="10sp" />

                <View android:layout_width="16dp" android:layout_height="3dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_legend_dot_red" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="P15" android:textColor="@color/text_tertiary" android:textSize="10sp" />

                <View android:layout_width="16dp" android:layout_height="3dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_legend_dot_green" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="P50" android:textColor="@color/text_tertiary" android:textSize="10sp" />

                <View android:layout_width="16dp" android:layout_height="3dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_legend_dot_teal" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="P85" android:textColor="@color/text_tertiary" android:textSize="10sp" />

                <View android:layout_width="16dp" android:layout_height="3dp" android:layout_marginEnd="4dp" android:background="@drawable/bg_legend_dot_orange" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P97" android:textColor="@color/text_tertiary" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════
         FOOTER — last measure + add button
    ═══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/llGrowthFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dernière mesure"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvLastMeasureDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabAddMeasure"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="+ Ajouter une mesure"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/brand_teal"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_syringe"
            app:iconTint="@color/white"
            app:iconSize="16dp"
            app:iconPadding="6dp"
            app:elevation="4dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
