<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvTitreFormInfirmier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ajouter un infirmier"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FF8A80"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etNomInfirmier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etPrenomInfirmier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Prénom"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etEmailInfirmierForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etTelInfirmier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Téléphone"
        android:inputType="phone"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerRoleInfirmier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnAnnulerFormInfirmier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Annuler"
            android:backgroundTint="#CCCCCC"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnValiderFormInfirmier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enregistrer"
            android:backgroundTint="#F5A623"/>
    </LinearLayout>
</LinearLayout>