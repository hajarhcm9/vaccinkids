<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rose"
    android:padding="24dp">

    <!-- Icône -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_circle_white_alpha">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_dialog_alert"
             />
    </FrameLayout>

    <!-- Titre dynamique -->
    <TextView
        android:id="@+id/tvTitreActivation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activer le centre"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Message dynamique -->
    <TextView
        android:id="@+id/tvMessageActivation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.5"
        android:gravity="center"
        android:background="@drawable/bg_info_box_white_alpha"
        android:padding="14dp"
        android:layout_marginBottom="20dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4DFFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAnnulerActivation"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Annuler"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_ghost_rose" />

        <Button
            android:id="@+id/btnConfirmerActivation"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Confirmer"
            android:textColor="#FF8A80"
            android:background="@drawable/bg_btn_white_round" />

    </LinearLayout>
</LinearLayout>