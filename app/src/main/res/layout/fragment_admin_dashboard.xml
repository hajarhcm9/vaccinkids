<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="110dp">

            <!-- ══════════════════════════════════════
                 HEADER — premium flat
            ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="10dp">

                <!-- Avatar + online dot -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_admin_avatar_circle">
                        <TextView
                            android:id="@+id/tvAdminAvatarInitials"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="AD"
                            android:textColor="@color/brand_coral"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Online dot -->
                    <View
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="1dp"
                        android:background="@drawable/bg_legend_dot_green" />
                </FrameLayout>

                <!-- Greeting + name + verified -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAdminGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bonjour,"
                        android:textColor="@color/slate_500"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAdminName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Administrateur"
                            android:textColor="@color/slate_900"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- Verified badge -->
                        <FrameLayout
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_kpi_icon_teal">
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_medical_staff"
                                app:tint="@color/brand_teal" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Notification bell -->
                <FrameLayout
                    android:id="@+id/btnAdminLogout"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_view_selector"
                    android:clickable="true"
                    android:elevation="3dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Déconnexion"
                        android:src="@drawable/ic_logout"
                        app:tint="@color/slate_700" />

                    <TextView
                        android:id="@+id/tvNotifBadge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_notif_dot"
                        android:gravity="center"
                        android:text="!"
                        android:textColor="@color/white"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- ══════════════════════════════════════
                 VIEW SELECTOR + PERIOD ROW
            ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingBottom="14dp">

                <!-- Selector card -->
                <LinearLayout
                    android:id="@+id/llViewSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_view_selector"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vue d'ensemble"
                        android:textColor="@color/slate_700"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/slate_500" />
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvAdminPeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_teal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/brand_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ══════════════════════════════════════
                 HERO CARD — glassmorphism premium
            ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/bg_gradient_hero_admin_premium">

                    <!-- Abstract circles -->
                    <View
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-90dp"
                        android:layout_marginBottom="-90dp"
                        android:alpha="0.08"
                        android:background="@drawable/bg_white_glow_circle" />

                    <View
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="-40dp"
                        android:layout_marginTop="-40dp"
                        android:alpha="0.06"
                        android:background="@drawable/bg_white_glow_circle" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="50dp"
                        android:layout_marginTop="18dp"
                        android:alpha="0.05"
                        android:background="@drawable/bg_white_glow_circle" />

                    <!-- Content -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!-- Left: stats -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="22dp"
                            android:paddingTop="22dp"
                            android:paddingBottom="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.04"
                                android:text="VACCINATIONS"
                                android:textColor="@color/white_75"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAdminDateBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:textColor="@color/white_50"
                                android:textSize="11sp" />

                            <!-- Big number -->
                            <TextView
                                android:id="@+id/tvTotalVaccines"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:includeFontPadding="false"
                                android:text="—"
                                android:textColor="@color/white"
                                android:textSize="54sp"
                                android:textStyle="bold" />

                            <!-- Growth badge -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_growth_pill"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="↑  Ce mois actuel"
                                    android:textColor="@color/white"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Right: bar chart glassmorphism -->
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChartSummary"
                            android:layout_width="130dp"
                            android:layout_height="match_parent"
                            android:alpha="0.0"
                            android:layout_marginEnd="14dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════
                 ALERT BANNER (hidden by default)
            ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/llAlertBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/error_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/error"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_marginEnd="10dp" android:contentDescription="@null"
                        android:src="@drawable/ic_notifications" app:tint="@color/error" />

                    <TextView android:id="@+id/tvAlertBannerText"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/error" android:textSize="13sp" android:textStyle="bold" />

                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" app:tint="@color/error" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════
                 KPI LABEL
            ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.07"
                android:text="INDICATEURS CLÉS"
                android:textColor="@color/stormy_teal"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- ══════════════════════════════════════
                 KPI GRID — Row 1
            ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <!-- Sessions -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvKpiSessions"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="4dp"
                    android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp"
                    app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:background="@drawable/bg_kpi_icon_blue">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_calendar_event" app:tint="@color/info" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvKpiSessions"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="—"
                            android:textColor="@color/slate_900" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Sessions" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:background="@drawable/bg_kpi_trend_green"
                            android:paddingHorizontal="7dp" android:paddingVertical="2dp"
                            android:text="À venir" android:textColor="@color/success_dark" android:textSize="9sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Centres -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvKpiCentres"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="4dp"
                    android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp"
                    app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:background="@drawable/bg_kpi_icon_pearl">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_building" app:tint="@color/stormy_teal" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvKpiCentres"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="—"
                            android:textColor="@color/slate_900" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Centres" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:background="@drawable/bg_kpi_trend_green"
                            android:paddingHorizontal="7dp" android:paddingVertical="2dp"
                            android:text="Actifs" android:textColor="@color/success_dark" android:textSize="9sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Personnel -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvKpiStaff"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="4dp"
                    android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp"
                    app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:background="@drawable/bg_kpi_icon_green">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_medical_staff" app:tint="@color/success_dark" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvKpiStaff"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="—"
                            android:textColor="@color/slate_900" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Personnel" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:background="@drawable/bg_kpi_trend_green"
                            android:paddingHorizontal="7dp" android:paddingVertical="2dp"
                            android:text="Actif" android:textColor="@color/success_dark" android:textSize="9sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ══════════════════════════════════════
                 KPI GRID — Row 2
            ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="22dp"
                android:orientation="horizontal">

                <!-- Vaccinations total -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvKpiVaccinations"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="4dp"
                    android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp"
                    app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:background="@drawable/bg_kpi_icon_teal">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_syringe" app:tint="@color/brand_teal" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvKpiVaccinations"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="—"
                            android:textColor="@color/slate_900" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Vaccinés" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:background="@drawable/bg_kpi_trend_green"
                            android:paddingHorizontal="7dp" android:paddingVertical="2dp"
                            android:text="Total" android:textColor="@color/success_dark" android:textSize="9sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Alertes critiques -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvKpiAlertes"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="4dp"
                    android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp"
                    app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:background="@drawable/bg_kpi_icon_red">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_notifications" app:tint="@color/error" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvKpiAlertes"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="—"
                            android:textColor="@color/error" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Alertes" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:background="@drawable/bg_kpi_trend_red"
                            android:paddingHorizontal="7dp" android:paddingVertical="2dp"
                            android:text="Stock" android:textColor="@color/error_dark" android:textSize="9sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bébés suivis -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvKpiBebes"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginHorizontal="4dp"
                    android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp"
                    app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:background="@drawable/bg_kpi_icon_almond">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_rdv" app:tint="@color/brand_coral" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvKpiBebes"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="—"
                            android:textColor="@color/slate_900" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Bébés" android:textColor="@color/text_secondary" android:textSize="10sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:background="@drawable/bg_kpi_trend_green"
                            android:paddingHorizontal="7dp" android:paddingVertical="2dp"
                            android:text="Suivis" android:textColor="@color/success_dark" android:textSize="9sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ══════════════════════════════════════
                 ACTIVITÉ label + card
            ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="22dp"
                android:paddingBottom="10dp">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:letterSpacing="0.07"
                    android:text="ACTIVITÉ RÉCENTE"
                    android:textColor="@color/stormy_teal" android:textSize="11sp" android:textStyle="bold" />

                <TextView android:id="@+id/tvViewAll"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:paddingVertical="4dp"
                    android:text="Voir tout →"
                    android:textColor="@color/stormy_teal" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/activityCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp">

                    <!-- Item 1 — Sessions -->
                    <LinearLayout android:id="@+id/llActivitySessions"
                        android:layout_width="match_parent" android:layout_height="70dp"
                        android:clickable="true" android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_activity_icon_green">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_calendar_event" app:tint="@color/success" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Sessions à venir"
                                android:textColor="@color/slate_900" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvActivitySessionsDetail"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="Chargement…"
                                android:textColor="@color/text_secondary" android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right" app:tint="@color/pearl_aqua" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/outline" />

                    <!-- Item 2 — RDV confirmés -->
                    <LinearLayout android:id="@+id/llActivityRdv"
                        android:layout_width="match_parent" android:layout_height="70dp"
                        android:clickable="true" android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_activity_icon_blue">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_rdv" app:tint="@color/info" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="RDV confirmés"
                                android:textColor="@color/slate_900" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvActivityRdvDetail"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="Chargement…"
                                android:textColor="@color/text_secondary" android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right" app:tint="@color/pearl_aqua" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/outline" />

                    <!-- Item 3 — Présents aujourd'hui -->
                    <LinearLayout android:id="@+id/llActivityPresents"
                        android:layout_width="match_parent" android:layout_height="70dp"
                        android:clickable="true" android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_kpi_icon_almond">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_medical_staff" app:tint="@color/brand_coral" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Patients présents"
                                android:textColor="@color/slate_900" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvActivityPresentsDetail"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" android:text="Chargement…"
                                android:textColor="@color/text_secondary" android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right" app:tint="@color/pearl_aqua" />
                    </LinearLayout>

                    <!-- Item 4 — Alertes stock (GONE if 0) -->
                    <View android:id="@+id/dividerActivity3"
                        android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/outline" android:visibility="gone" />

                    <LinearLayout android:id="@+id/llActivityAlertes"
                        android:layout_width="match_parent" android:layout_height="70dp"
                        android:clickable="true" android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:visibility="gone">
                        <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                            android:background="@drawable/bg_activity_icon_red">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center" android:contentDescription="@null"
                                android:src="@drawable/ic_package" app:tint="@color/error" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Stock critique"
                                android:textColor="@color/error" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvActivityAlertesDetail"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary" android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right" app:tint="@color/error" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Last updated -->
            <TextView
                android:id="@+id/tvLastUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:textColor="@color/slate_400"
                android:textSize="11sp" />

            <!-- Legacy compat -->
            <LinearLayout android:id="@+id/llAdminActivities"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
