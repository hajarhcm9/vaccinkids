<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Nom lot + statut -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNomLot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lot L001 - Sanofi"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#212121" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatut"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUVERT"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="#4CAF50" />

        </LinearLayout>

        <!-- Métriques -->
        <TextView
            android:id="@+id/tvMetriques"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Utilisées: 4 | Gaspillées: 0 | Restantes: 6"
            android:textSize="13sp"
            android:textColor="#757575" />

        <!-- Boutons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnDeclarerGaspillage"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Déclarer gaspillage"
                android:textSize="11sp"
                android:textColor="#FF9800"
                app:strokeColor="#FF9800" />

            <Button
                android:id="@+id/btnFermerFlacon"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Fermer flacon"
                android:textSize="11sp"
                android:textColor="#F44336"
                app:strokeColor="#F44336" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>