<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvVaccinFlacon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvLotFlacon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp" />

        <!-- Barre de progression doses -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressDoses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:trackColor="#EEEEEE"
            app:indicatorColor="#F5A623"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tvDosesInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvIndicateurGaspillage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Boutons action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMarquerDose"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="+ Dose utilisée"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50" />

            <Button
                android:id="@+id/btnMarquerGaspillage"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Dose gaspillée"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF7043" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>