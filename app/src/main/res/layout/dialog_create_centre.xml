<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <!-- ── Header gradient ────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_more_hero">

            <View android:layout_width="110dp" android:layout_height="110dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="-30dp" android:layout_marginTop="-30dp"
                android:alpha="0.07" android:background="@drawable/bg_white_glow_circle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                    android:background="@drawable/bg_admin_avatar_circle">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:layout_gravity="center" android:contentDescription="@null"
                        android:src="@drawable/ic_building" app:tint="@color/brand_coral" />
                </FrameLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/tvCentreFormTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Nouveau centre"
                        android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="Complétez les informations"
                        android:textColor="@color/white_75" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ── Form body ──────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:letterSpacing="0.05"
                android:text="IDENTIFICATION"
                android:textColor="@color/stormy_teal" android:textSize="10sp" android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCentreNom"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" android:hint="Nom du centre *"
                app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/stormy_teal" app:hintTextColor="@color/text_secondary"
                app:startIconDrawable="@drawable/ic_building" app:startIconTint="@color/stormy_teal">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCentreNom"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:letterSpacing="0.05"
                android:text="LOCALISATION"
                android:textColor="@color/stormy_teal" android:textSize="10sp" android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCentreAdresse"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" android:hint="Adresse complète *"
                app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/stormy_teal" app:hintTextColor="@color/text_secondary"
                app:startIconDrawable="@drawable/ic_location" app:startIconTint="@color/stormy_teal">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCentreAdresse"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="text" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- GPS row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCentreGpsLat"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:hint="Latitude"
                    app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/stormy_teal" app:hintTextColor="@color/text_secondary">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCentreGpsLat"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCentreGpsLng"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    android:hint="Longitude"
                    app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/stormy_teal" app:hintTextColor="@color/text_secondary">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCentreGpsLng"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:letterSpacing="0.05"
                android:text="CONTACT"
                android:textColor="@color/stormy_teal" android:textSize="10sp" android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCentreTelephone"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="4dp" android:hint="Téléphone *"
                app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/stormy_teal" app:hintTextColor="@color/text_secondary"
                app:startIconDrawable="@drawable/ic_phone" app:startIconTint="@color/stormy_teal">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCentreTelephone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="phone" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- ── Button row ─────────────────────── -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/outline" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCentreCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:text="Annuler" android:textSize="14sp"
                app:strokeColor="@color/stormy_teal" app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCentreSave"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="Enregistrer" android:textSize="14sp"
                app:backgroundTint="@color/stormy_teal" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
