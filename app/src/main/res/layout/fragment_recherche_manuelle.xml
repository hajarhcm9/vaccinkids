<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- ══════════════════════════════════════
         GRADIENT HEADER
    ═══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_more_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp">

        <FrameLayout
            android:id="@+id/btnBackRecherche"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_alpha"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Retour"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saisie manuelle"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Recherche par code carnet"
                android:textColor="#BBFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <!-- ══════════════════════════════════════
         SCROLLABLE BODY
    ═══════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <!-- ── Hero illustration zone ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_teal">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_scan"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Entrez le code unique du carnet"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Visible dans l'application parent, rubrique « Carte QR »"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.3" />

                <!-- Guide chips row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_badge_teal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="📱 App parent"
                        android:textColor="@color/brand_teal_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_badge_info"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="📄 Carnet physique"
                        android:textColor="@color/info_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_success"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="🖨 QR imprimé"
                        android:textColor="@color/success_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Input card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="CODE SÉCURISÉ DU CARNET"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="VK1.abc123… (69 caractères)"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/pearl_aqua"
                        app:endIconMode="clear_text"
                        app:endIconTint="@color/text_secondary"
                        app:startIconDrawable="@drawable/ic_scan"
                        app:startIconTint="@color/brand_teal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRechercheCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="3"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="6dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="Le code VK1. contient 69 caractères. Il peut aussi être collé depuis un lien ou un QR code."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRechercheValider"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:stateListAnimator="@null"
                        android:text="🔍  Rechercher le carnet"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_qr_btn"
                        app:backgroundTint="@null"
                        app:cornerRadius="26dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Loading bar ── -->
            <ProgressBar
                android:id="@+id/pbRecherche"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/brand_teal"
                android:visibility="gone" />

            <!-- ── Error / info band ── -->
            <LinearLayout
                android:id="@+id/llRechercheError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_error"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_notifications"
                    android:drawablePadding="8dp"
                    android:id="@+id/tvRechercheMessage"
                    android:textColor="@color/error"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ── Result card (hidden by default) ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvRechercheResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Colored left status bar -->
                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="@color/success" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Found badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_success"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="✓  CARNET TROUVÉ"
                            android:textColor="@color/success_dark"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <!-- Avatar + name row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Avatar with initials (sex-colored) -->
                            <FrameLayout
                                android:id="@+id/flRechercheAvatar"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_circle_staff_primary">
                                <TextView
                                    android:id="@+id/tvRechercheInitials"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="?"
                                    android:textColor="@color/white"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvRechercheResultName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Nom du patient"
                                    android:textColor="@color/text_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvRechercheResultAge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Âge"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Sex badge -->
                            <TextView
                                android:id="@+id/tvRechercheSex"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_info"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:text="Garçon"
                                android:textColor="@color/info_dark"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Info chips row (RDV + Vaccin) -->
                        <LinearLayout
                            android:id="@+id/llRechercheChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvRechercheRdvBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_badge_teal"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:text="📅 RDV"
                                android:textColor="@color/brand_teal_dark"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tvRechercheVaccinBadge"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/badge_orange_bg"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:textColor="@color/warning_dark"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/outline" />

                        <!-- Open dossier button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRechercheOuvrir"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:stateListAnimator="@null"
                            android:text="Ouvrir le dossier →"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_qr_btn"
                            app:backgroundTint="@null"
                            app:cornerRadius="25dp" />

                        <!-- Nouvelle recherche -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNouvelleRecherche"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="4dp"
                            android:text="Nouvelle recherche"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:backgroundTint="@android:color/transparent"
                            app:rippleColor="@color/teal_50" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
