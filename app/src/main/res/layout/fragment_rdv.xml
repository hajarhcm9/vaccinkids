<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rdvRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ═══ HEADER ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp"
            android:background="@color/bg_screen">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rendez-vous"
                    android:textSize="26sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patients de la session du jour"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/rdvProgress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ SESSION CARD (improved) ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Teal top accent bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@color/brand_teal" />

                <!-- Session selector row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_badge_teal"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_calendar_event"
                            android:contentDescription="@null"
                            app:tint="@color/brand_teal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SESSION DU JOUR"
                            android:textSize="10sp"
                            android:textColor="@color/brand_teal"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <Spinner
                            android:id="@+id/rdvSessionSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@null" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Session action buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:paddingTop="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rdvOpenQueue"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="File d'attente"
                        android:textSize="11sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_coral"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_queue_people"
                        app:iconTint="@color/white"
                        app:iconSize="14dp"
                        app:iconPadding="4dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rdvOpenVials"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Flacons"
                        android:textSize="11sp"
                        android:textColor="@color/brand_teal"
                        android:textStyle="bold"
                        app:backgroundTint="@color/teal_50"
                        app:strokeColor="@color/brand_teal"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_syringe"
                        app:iconTint="@color/brand_teal"
                        app:iconSize="14dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rdvOpenStats"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Stats"
                        android:textSize="11sp"
                        android:textColor="@color/brand_blue"
                        app:backgroundTint="@color/info_light"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_dashboard"
                        app:iconTint="@color/brand_blue"
                        app:iconSize="14dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rdvStartSession"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Démarrer"
                        android:textSize="11sp"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/brand_teal"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_rdv"
                        app:iconTint="@color/white"
                        app:iconSize="14dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rdvEndSession"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Terminer"
                        android:textSize="11sp"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/error"
                        app:cornerRadius="19dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ SEARCH BAR ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_scan"
                    android:contentDescription="@null"
                    app:tint="@color/brand_teal"
                    android:layout_marginEnd="10dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rdvSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Rechercher bébé, parent ou téléphone…"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ STATUS FILTER CHIPS ═══ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/rdvStatusFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- ═══ OFFLINE BANNER ═══ -->
        <LinearLayout
            android:id="@+id/rdvOfflineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/warning_light"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="9dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/rdvOfflineText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/warning_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ═══ STATUS MESSAGE ═══ -->
        <TextView
            android:id="@+id/rdvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <!-- ═══ RDV LIST ═══ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rdvList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp" />

    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
