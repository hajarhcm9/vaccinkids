<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rdvRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/staff_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp">

        <TextView
            style="@style/TextAppearance.Vaccinkid.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rendez-vous" />

        <TextView
            style="@style/TextAppearance.Vaccinkid.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Selectionnez une session puis traitez les patients." />

        <Spinner
            android:id="@+id/rdvSessionSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Rechercher bebe, parent ou telephone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rdvSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/rdvStatusFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rdvOpenQueue"
                style="@style/Widget.Vaccinkid.Button.Coral"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="File"
                app:icon="@drawable/ic_queue_people" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rdvOpenVials"
                style="@style/Widget.Vaccinkid.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Flacons"
                app:icon="@drawable/ic_syringe"
                app:iconTint="@color/brand_teal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rdvStartSession"
                style="@style/Widget.Vaccinkid.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Demarrer session" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rdvEndSession"
                style="@style/Widget.Vaccinkid.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Terminer session" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/rdvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rdvMessage"
            style="@style/TextAppearance.Vaccinkid.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:textColor="@color/text_secondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rdvList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
