<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rdvRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/staff_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp">

        <TextView
            style="@style/TextAppearance.Vaccinkid.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rendez-vous" />

        <TextView
            style="@style/TextAppearance.Vaccinkid.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Selectionnez une session puis traitez les patients." />

        <!-- Session selector card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="4dp"
                android:paddingVertical="4dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar_event"
                    android:contentDescription="@null"
                    app:tint="@color/brand_teal" />
                <Spinner
                    android:id="@+id/rdvSessionSpinner"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Search bar -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Rechercher bébé, parent ou téléphone"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/brand_teal"
            app:startIconDrawable="@drawable/ic_scan"
            app:startIconTint="@color/brand_teal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rdvSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/rdvStatusFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rdvOpenQueue"
                style="@style/Widget.Vaccinkid.Button.Coral"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="File"
                app:icon="@drawable/ic_queue_people" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rdvOpenVials"
                style="@style/Widget.Vaccinkid.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Flacons"
                app:icon="@drawable/ic_syringe"
                app:iconTint="@color/brand_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rdvOpenStats"
                style="@style/Widget.Vaccinkid.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Stats"
                android:visibility="gone"
                app:icon="@drawable/ic_dashboard"
                app:iconTint="@color/brand_teal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rdvStartSession"
                style="@style/Widget.Vaccinkid.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Demarrer session" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rdvEndSession"
                style="@style/Widget.Vaccinkid.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Terminer session" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/rdvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rdvMessage"
            style="@style/TextAppearance.Vaccinkid.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:textColor="@color/text_secondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rdvList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
