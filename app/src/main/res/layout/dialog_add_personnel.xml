<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- CIN (new only) -->
    <LinearLayout
        android:id="@+id/layoutCin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCin"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CIN (Carte d'Identité Nationale)"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/brand_teal"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/brand_teal"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Nom -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNom"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom de famille *"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/brand_teal"
        app:startIconDrawable="@drawable/ic_medical_staff"
        app:startIconTint="@color/brand_teal"
        android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Prénom -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPrenom"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Prénom *"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/brand_teal"
        android:layout_marginBottom="14dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPrenom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Rôle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rôle *"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/spinnerRole"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_outlined"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="14dp" />

    <!-- Centre -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Centre affecté *"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/spinnerCentre"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_outlined"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="14dp" />

    <!-- Mot de passe -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPassword"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mot de passe"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/brand_teal"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/brand_teal"
        app:endIconMode="password_toggle"
        android:layout_marginBottom="4dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvPasswordHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Laisser vide pour conserver le mot de passe actuel"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:textStyle="italic"
        android:visibility="gone" />

</LinearLayout>
