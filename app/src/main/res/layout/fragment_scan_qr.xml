<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Back button -->
    <ImageView
        android:id="@+id/btnBackScan"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="20dp"
        android:contentDescription="Retour"
        android:rotation="180"
        android:src="@drawable/ic_logout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <!-- Titles -->
    <TextView
        android:id="@+id/tvScanTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Scan QR Code"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvScanSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Scannez le QR code du carnet de santé"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScanTitle" />

    <!-- Camera / QR viewfinder -->
    <FrameLayout
        android:id="@+id/scanContainer"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_scan_viewfinder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScanSubtitle">

        <!-- Dimmed overlay around corners (visual corner brackets via bg_scan_corners border) -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:alpha="0.25"
            android:contentDescription="@null"
            android:src="@drawable/ic_scan"
            app:tint="@color/brand_teal" />

        <!-- Animated scan line -->
        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:background="@color/brand_teal"
            android:alpha="0.8" />
    </FrameLayout>

    <!-- Open camera button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanner"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="28dp"
        android:text="Ouvrir la caméra"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_teal"
        app:cornerRadius="26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scanContainer" />

    <!-- Manual entry link -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaisieManuelle"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Saisie manuelle"
        android:textColor="@color/brand_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnScanner" />

    <!-- Torch FAB -->
    <FrameLayout
        android:id="@+id/btnTorch"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/bg_fab_teal"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="Torche"
            android:src="@drawable/ic_notifications"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Detection overlay card (shown after successful scan) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvDetectedPatient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/brand_teal_dark"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDetectedAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_medical_staff"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/white_80"
                app:strokeWidth="1.5dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enfant détecté"
                    android:textColor="@color/white_75"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvDetectedName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Youssef Amine"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetectedAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 ans, 3 mois"
                    android:textColor="@color/white_80"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_white_alpha">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Confirmer"
                    android:src="@drawable/ic_syringe"
                    app:tint="@color/brand_teal" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
