<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- En-tête -->
    <ImageView
        android:id="@+id/btnBackScan"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_logout"
        android:rotation="180"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black" />

    <TextView
        android:id="@+id/tvScanTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Scan QR Code"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvScanSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Scannez le QR code du carnet de santé"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScanTitle" />

    <!-- Viseur -->
    <FrameLayout
        android:id="@+id/scanContainer"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_scan_viewfinder"
        app:layout_constraintBottom_toTopOf="@id/btnTorch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScanSubtitle">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp"
            android:alpha="0.3"
            android:src="@drawable/ic_scan"
            app:tint="@color/black"
            android:contentDescription="@null" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanner"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="24dp"
        app:backgroundTint="@color/brand_teal"
        android:text="Ouvrir la caméra"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/scanContainer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaisieManuelle"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Saisie manuelle"
        android:textColor="@color/brand_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnScanner" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTorch"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="100dp"
        app:backgroundTint="@color/brand_teal_dark"
        app:icon="@drawable/ic_notifications"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Notification détection (Enfant détecté) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvDetectedPatient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/brand_teal_dark"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDetectedAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_medical_staff"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enfant détecté"
                    android:textColor="@color/white_75"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvDetectedName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Youssef Amine"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetectedAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 ans, 3 mois"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_white_alpha"
                android:padding="4dp"
                android:src="@drawable/ic_syringe"
                app:tint="@color/brand_teal" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>