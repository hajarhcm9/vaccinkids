<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F0">

    <!-- Header orange -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8920A"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏥 Centres de vaccination"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ✅ Blanc pur sur fond orange foncé = contraste OK -->
        <TextView
            android:id="@+id/tvTotalActifs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Centres actifs : 1 / 10"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>

    <!-- Info appui long -->
    <!-- ✅ Gris foncé #555555 sur fond crème = contraste OK -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Appui long sur un centre pour activer / désactiver"
        android:textSize="12sp"
        android:textColor="#555555"
        android:gravity="center"
        android:padding="8dp"
        android:background="#FFF3E0" />

    <!-- Liste centres -->
    <ListView
        android:id="@+id/listViewCentres"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:padding="8dp" />

</LinearLayout>