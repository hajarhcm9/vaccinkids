<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- ══════ HEADER ══════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingTop="22dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/btnBackProfil"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_kpi_card"
            android:elevation="2dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Retour"
                android:rotation="180"
                android:src="@drawable/ic_logout"
                app:tint="@color/brand_teal" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Dossier Enfant"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <!-- ══════ SCROLLABLE CONTENT ══════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingBottom="32dp">

            <!-- ── Identity card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="center_vertical">

                    <!-- Avatar initials circle -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_kpi_icon_blue">
                        <TextView
                            android:id="@+id/tvProfilInitials"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="AB"
                            android:textColor="@color/info_dark"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Name + age + gender -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProfilName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nom Prénom"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfilAge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Âge"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvProfilGender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_badge_info"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="—"
                            android:textColor="@color/info_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Parent contact card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PARENT / TUTEUR"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvParentNom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Non renseigné"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvParentPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="—"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <!-- Action buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCallParent"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_btn_teal_pill"
                            android:text="Appeler"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:stateListAnimator="@null"
                            app:backgroundTint="@null"
                            app:cornerRadius="22dp"
                            app:rippleColor="@color/teal_100" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSmsParent"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="SMS"
                            android:textColor="@color/brand_teal"
                            android:textSize="14sp"
                            app:strokeColor="@color/brand_teal"
                            app:strokeWidth="1.5dp"
                            app:cornerRadius="22dp"
                            app:rippleColor="@color/teal_50" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Section: Eligible RDVs ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="RENDEZ-VOUS ÉLIGIBLES"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEligibleRdv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmptyRdv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Aucun rendez-vous éligible aujourd'hui"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- ── Section: Vaccination history ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="HISTORIQUE VACCINATIONS"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVaccinHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmptyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Aucun historique disponible"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- ── Growth chart button ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewGrowth"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Courbe de croissance"
                android:textColor="@color/brand_teal"
                android:textSize="14sp"
                app:strokeColor="@color/brand_teal"
                app:strokeWidth="1.5dp"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_dashboard"
                app:iconTint="@color/brand_teal"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:rippleColor="@color/teal_50" />

            <!-- ── QR code button ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewQr"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Afficher le code QR"
                android:textColor="@color/brand_teal"
                android:textSize="14sp"
                app:strokeColor="@color/brand_teal"
                app:strokeWidth="1.5dp"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_scan"
                app:iconTint="@color/brand_teal"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:rippleColor="@color/teal_50" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
