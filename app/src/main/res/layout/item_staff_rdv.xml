<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left teal accent bar -->
        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/brand_teal" />

        <!-- Card content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Row 1: time chip + name/age + status badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Time chip -->
                <TextView
                    android:id="@+id/staffRdvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_time_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="09:30"
                    android:textColor="@color/brand_teal_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Name + meta -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/staffRdvBaby"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/staffRdvMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Status badge -->
                <TextView
                    android:id="@+id/staffRdvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2: parent info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_medical_staff"
                    android:contentDescription="@null"
                    app:tint="@color/brand_teal"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/staffRdvParent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Row 3: phone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_phone"
                    android:contentDescription="@null"
                    app:tint="@color/text_secondary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/staffRdvPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="@color/outline" />

            <!-- Row 3: action buttons (2+2 layout) -->
            <LinearLayout
                android:id="@+id/staffRdvActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Primary actions row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Présent -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/staffRdvPresent"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_btn_teal_pill"
                        android:text="Présent"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        android:elevation="2dp"
                        app:backgroundTint="@null"
                        app:cornerRadius="21dp"
                        app:icon="@drawable/ic_syringe"
                        app:iconTint="@color/white"
                        app:iconSize="16dp"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp" />

                    <!-- Vacciner -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/staffRdvVaccinate"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_qr_btn"
                        android:text="Vacciner"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"
                        android:elevation="2dp"
                        app:backgroundTint="@null"
                        app:cornerRadius="21dp"
                        app:icon="@drawable/ic_scan"
                        app:iconTint="@color/white"
                        app:iconSize="16dp"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp" />
                </LinearLayout>

                <!-- Confirmer row (visible only for EN_LISTE_ATTENTE) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/staffRdvConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_teal_pill"
                    android:text="Confirmer la place"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    android:elevation="2dp"
                    android:visibility="gone"
                    app:backgroundTint="@null"
                    app:cornerRadius="21dp" />

                <!-- Secondary actions row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Absent -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/staffRdvAbsent"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Absent"
                        android:textSize="13sp"
                        android:textColor="@color/error"
                        app:strokeColor="@color/error"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="19dp"
                        app:rippleColor="@color/error_light" />

                    <!-- Dossier -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/staffRdvGrowth"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Dossier"
                        android:textSize="13sp"
                        android:textColor="@color/brand_teal"
                        app:strokeColor="@color/brand_teal"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="19dp"
                        app:rippleColor="@color/teal_100" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
