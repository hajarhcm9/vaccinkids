<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/btnBackQr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_kpi_card"
            android:elevation="2dp"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Retour"
                android:rotation="180"
                android:src="@drawable/ic_logout"
                app:tint="@color/brand_teal" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvQrBebeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:text="Code QR" />
    </LinearLayout>

    <!-- CARD -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Présentez ce code QR à l'infirmier(e)"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <ProgressBar
                android:id="@+id/qrProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:scaleType="fitCenter"
                android:contentDescription="QR Code"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvQrError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/error_dark"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code complet :"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvQrValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
