<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Vaccinkid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/staff_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_teal_light</item>
        <item name="colorSecondary">@color/staff_secondary</item>
        <item name="colorTertiary">@color/brand_rose</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorAccent">@color/staff_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/staff_primary_dark</item>
        <item name="android:navigationBarColor">@color/staff_surface</item>
        <item name="android:windowBackground">@color/staff_background</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.Vaccinkid" parent="Base.Theme.Vaccinkid" />

    <style name="Widget.Vaccinkid.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
    </style>

    <style name="Widget.Vaccinkid.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Vaccinkid.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/brand_teal</item>
        <item name="android:textColor">@color/text_on_primary</item>
    </style>

    <style name="Widget.Vaccinkid.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/brand_teal</item>
        <item name="android:textColor">@color/brand_teal</item>
    </style>

    <style name="Widget.Vaccinkid.Button.Coral" parent="Widget.Vaccinkid.Button">
        <item name="backgroundTint">@color/brand_coral</item>
    </style>

    <style name="Widget.Vaccinkid.Button.Danger" parent="Widget.Vaccinkid.Button">
        <item name="backgroundTint">@color/error</item>
    </style>

    <style name="TextAppearance.Vaccinkid.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Vaccinkid.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Vaccinkid.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Vaccinkid.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.Vaccinkid.OnPrimary" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
