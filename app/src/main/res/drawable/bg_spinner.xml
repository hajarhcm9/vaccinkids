<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- État pressé -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8F5E9" />
            <stroke android:width="2dp" android:color="#4CAF50" />
            <corners android:radius="8dp" />
            <padding
                android:bottom="8dp"
                android:left="12dp"
                android:right="12dp"
                android:top="8dp" />
        </shape>
    </item>

    <!-- État focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F1F8E9" />
            <stroke android:width="2dp" android:color="#66BB6A" />
            <corners android:radius="8dp" />
            <padding
                android:bottom="8dp"
                android:left="12dp"
                android:right="12dp"
                android:top="8dp" />
        </shape>
    </item>

    <!-- État normal (défaut) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#BDBDBD" />
            <corners android:radius="8dp" />
            <padding
                android:bottom="8dp"
                android:left="12dp"
                android:right="12dp"
                android:top="8dp" />
        </shape>
    </item>

</selector>