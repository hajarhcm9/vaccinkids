<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- État sélectionné -->
    <item android:state_checked="true" android:color="@color/design_default_color_secondary">
        <shape android:shape="rectangle">
            <solid android:color="#4CAF50" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="6dp"
                android:left="14dp"
                android:right="14dp"
                android:top="6dp" />
        </shape>
    </item>

    <!-- État pressé -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#388E3C" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="6dp"
                android:left="14dp"
                android:right="14dp"
                android:top="6dp" />
        </shape>
    </item>

    <!-- État désactivé -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#E0E0E0" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#BDBDBD" />
            <padding
                android:bottom="6dp"
                android:left="14dp"
                android:right="14dp"
                android:top="6dp" />
        </shape>
    </item>

    <!-- État normal (défaut) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#4CAF50" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="6dp"
                android:left="14dp"
                android:right="14dp"
                android:top="6dp" />
        </shape>
    </item>

</selector>