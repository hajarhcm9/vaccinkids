# ============================================================
# VacciniKids — Staging environment variables
# Copy to .env.staging, fill in real values, never commit.
# ============================================================

# ---- Server ----
NODE_ENV=staging
PORT=3000
LOG_USER_HASH_SALT=CHANGE-ME-staging-log-salt-128hex
METRICS_BEARER_TOKEN=CHANGE-ME-staging-metrics-token

# ---- PostgreSQL ----
DB_NAME=vaccinikids_staging
DB_USER=vaccinikids_staging_user
DB_PASSWORD=CHANGE-ME-strong-db-password
# DATABASE_SSL_MODE=verify-full          # enable once DB has TLS cert

# ---- Redis (password required in staging) ----
REDIS_PASSWORD=CHANGE-ME-strong-redis-password
# The api service builds this from REDIS_PASSWORD automatically; set here for
# the redis container's --requirepass argument.
REDIS_URL=redis://:CHANGE-ME-strong-redis-password@redis:6379

# ---- JWT ----
JWT_SECRET=CHANGE-ME-128-hex-chars-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE-ME-128-hex-chars-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=CHANGE-ME-128-hex-chars-otp-secret

# ---- SMS — SmsPartner Morocco (real provider) ----
SMS_PROVIDER=smspartner
SMS_API_KEY=your-real-smspartner-api-key
SMS_SENDER_NAME=VacciniKids
SMS_API_URL=https://api.smspartner.fr/v1/send
SMS_AUTH_SCHEME=Bearer
ALLOW_PROVIDER_STUBS=false

# ---- Firebase Cloud Messaging (real project) ----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ---- Email ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-staging-email@example.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM="VacciniKids Staging <staging@vaccinikids.ma>"

# ---- CORS — allow the staging domain and the Android build variant ----
CORS_ORIGIN=https://staging.vaccinikids.ma

# ---- Caddy domain (update Caddyfile.staging to match) ----
STAGING_DOMAIN=staging.vaccinikids.ma

# ---- Staff Android — staging build variant ----
STAFF_API_BASE_URL=https://staging.vaccinikids.ma/api/

# ---- Optional surfaces (enable as needed) ----
WEB_ADMIN_ENABLED=false
WAITING_ROOM_ENABLED=false
SWAGGER_ENABLED=false

# ---- Audit (enable when an external collector is available) ----
AUDIT_EXTERNAL_URL=
AUDIT_EXTERNAL_SECRET=
AUDIT_EXTERNAL_REQUIRED=false
