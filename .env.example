# ============================================
# VacciniKids Backend — Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# ---- Server ----
PORT=3000
NODE_ENV=development
# API startup never runs migrations or background workers.
# Run `npm run migrate` and `npm run worker:reminders` as separate processes.
LOG_USER_HASH_SALT=dev-only-replace-with-a-random-log-salt
METRICS_BEARER_TOKEN=dev-only-replace-with-a-metrics-token

# External append-only audit collector. Required in production.
AUDIT_EXTERNAL_URL=
AUDIT_EXTERNAL_SECRET=
AUDIT_EXTERNAL_REQUIRED=false
EXPORT_MAX_BYTES=10485760

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vaccinikids
TEST_DB_NAME=vaccinikids_test
DB_USER=change-me-db-user
DB_PASSWORD=change-me-db-password
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ---- JWT ----
JWT_SECRET=dev-only-replace-with-128-hex-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-replace-with-a-different-128-hex-secret
JWT_REFRESH_EXPIRES_IN=7d

# ---- OTP ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=dev-only-replace-with-a-different-128-hex-secret

# ---- SMS API (SmsPartner Morocco) ----
SMS_PROVIDER=smspartner
SMS_API_KEY=your-smspartner-api-key
SMS_SENDER_NAME=VacciniKids
SMS_API_URL=https://api.smspartner.fr/v1/send
SMS_AUTH_SCHEME=Bearer
# Stubs are enabled automatically only in development and test.
ALLOW_PROVIDER_STUBS=false
PROVIDER_TIMEOUT_MS=5000
PROVIDER_RETRIES=2
PROVIDER_RETRY_BACKOFF_MS=250

# ---- Firebase Cloud Messaging ----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ---- Email provider ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="VacciniKids <noreply@vaccinikids.ma>"

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ---- Redis and shared rate limiting ----
# Required in production. Use the same Redis instance for every API replica.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REQUIRE_REDIS=false
REDIS_CONNECT_TIMEOUT_MS=3000
# Number of trusted reverse proxies, or comma-separated proxy IP/CIDR values.
TRUST_PROXY=1
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REFRESH_WINDOW_MS=300000
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_EXPORT_WINDOW_MS=3600000
RATE_LIMIT_EXPORT_MAX=20
RATE_LIMIT_KIOSK_WINDOW_MS=60000
RATE_LIMIT_KIOSK_MAX=120

# ---- Optional API documentation (disabled by default in production) ----
SWAGGER_ENABLED=true

# ---- Optional web surfaces (disabled by default in production) ----
WEB_ADMIN_ENABLED=false
WAITING_ROOM_ENABLED=false
WEB_ADMIN_SESSION_DAYS=7
KIOSK_TOKEN_MINUTES=15

# ---- Offline synchronization ----
# Keep false in production until the approved command matrix is enabled for the pilot.
SYNC_PUSH_ENABLED=false

# ---- Retention (data:purge is dry-run unless RETENTION_APPLY=true) ----
RETENTION_APPLY=false
RETENTION_OTP_HOURS=24
RETENTION_REFRESH_DAYS=30
# Enable only after compliance approval.
# RETENTION_NOTIFICATION_DAYS=90
# RETENTION_SYNC_DAYS=30

# ---- Parent React Native build configuration ----
MOBILE_ENV=development
API_BASE_URL=http://localhost:3000/api

# ---- Staff Android release build configuration ----
STAFF_API_BASE_URL=https://staging.example.ma/api/
STAFF_ANDROID_RELEASE_STORE_FILE=
STAFF_ANDROID_RELEASE_STORE_PASSWORD=
STAFF_ANDROID_RELEASE_KEY_ALIAS=
STAFF_ANDROID_RELEASE_KEY_PASSWORD=
ANDROID_RELEASE_STORE_FILE=
ANDROID_RELEASE_STORE_PASSWORD=
ANDROID_RELEASE_KEY_ALIAS=
ANDROID_RELEASE_KEY_PASSWORD=

# ---- Docker PostgreSQL ----
POSTGRES_USER=change-me-db-user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=vaccinikids

# ---- One-time production admin bootstrap ----
# Set only while running `npm run admin:bootstrap`, then remove from the environment.
BOOTSTRAP_ADMIN_CIN=
BOOTSTRAP_ADMIN_NOM=
BOOTSTRAP_ADMIN_PRENOM=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_CENTRE_ID=
